class Solution {
  public static String stringReverse(String str) {
    char[] arr = str.toCharArray();
    int i=0;
    int j = arr.length-1;
    while(i < j) {
      if(Character.isDigit(arr[i])) {
        i++;
      }
      else if(Character.isDigit(arr[j])) {
        j--;
      }
      else {
        char temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
        i++;
        j--;
      }
    }
  }
}
